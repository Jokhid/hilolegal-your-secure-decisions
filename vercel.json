{
  "redirects": [
    { "source": "/test-salud-financiera.html", "destination": "/test-salud-financiera", "permanent": true },
    { "source": "/herramientas/ahorro-potencial/index.html", "destination": "/ahorro-potencial", "permanent": true },
    { "source": "/herramientas/ahorro-potencial", "destination": "/ahorro-potencial", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
