{
  "redirects": [
    { "source": "/test-salud-financiera.html", "destination": "/test-salud-financiera", "permanent": true },
    { "source": "/herramientas/ahorro-potencial/index.html", "destination": "/ahorro-potencial", "permanent": true },
    { "source": "/herramientas/ahorro-potencial", "destination": "/ahorro-potencial", "permanent": true }
